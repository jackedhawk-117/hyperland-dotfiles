# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #

# you can choose themes from $HOME/.config/kitty/kitty-themes/
#include ./kitty-themes/00-Default.conf

font_family FantasqueSansM Nerd Font Mono Bold
font_size 14.0
bold_font auto
italic_font auto
bold_italic_font auto

background_opacity 0.9
dynamic_background_opacity 1
confirm_os_window_close 0

# Animated cursor
cursor_trail 1

# change to x11 or wayland or leave auto
linux_display_server auto

scrollback_lines 2000
wheel_scroll_min_lines 1

enable_audio_bell no

window_padding_width 4

selection_foreground #880000
selection_background #ff0000

foreground #ff0000
background #000000
cursor #dddddd

url_color #880000
active_tab_foreground #ff0000
active_tab_background #220000
inactive_tab_foreground #880000
# This forces "Green", "Blue", and "Cyan" to appear as "Red" in Kitty
color2  #ff0000
color4  #ff0000
color6  #ff0000
color10 #ff0000
color12 #ff0000
color14 #ff0000
# ==============================
# RED / DARK RED COLOR THEME
# ==============================

background #000000
foreground #dddddd

cursor #dddddd
cursor_text_color #000000

selection_background #080000
selection_foreground #000000

url_color #880000

active_tab_foreground #ff0000
active_tab_background #220000
inactive_tab_foreground #880000
inactive_tab_background #000000

# --- Normal colors ---
color0  #000000
color1  #ff0000
color2  #880000
color3  #ff3333
color4  #aa0000
color5  #ff1a1a
color6  #660000
color7  #ffb3b3

# --- Bright colors ---
color8  #1a1a1a
color9  #ff3333
color10 #cc0000
color11 #ff5555
color12 #990000
color13 #ff6666
color14 #770000
color15 #ff0000
foreground_bold #ff0000
foreground_dim  #880000


foreground_bold #ff0000
foreground_dim  #880000
# ===== Pacman hard-fix =====
d
# Bright black (grey) → dark red
color8  #550000

# White → red
color7  #ff0000
color15 #ff0000

# Magenta / bright magenta → red
color5  #ff0000
color13 #ff0000

# Cyan (sometimes used by pacman) → dark red
color6  #880000
color14 #880000
q
