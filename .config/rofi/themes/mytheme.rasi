/**
 * Final Clean Red Theme (Fixed Selection Bug)
 * No white backgrounds, no empty selection bar
 */

* {
    font: "JetBrainsMono Nerd Font Medium 13";

    /* Kill all default backgrounds */
    background-color: transparent;
    border: 0;

    /* Default text */
    foreground: #ff0000;
}

/* ===== WINDOW ===== */
window {
    location: center;
    anchor: center;

    transparency: "real";
    background-color: rgba(0,0,0,0.5);

    border: 2px;
    border-color: #ff0000;
    border-radius: 12px;

    padding: 10px;
}

/* ===== MAIN ===== */
mainbox {
    background-color: transparent;
    spacing: 8px;
    children: [ inputbar, listview ];
}

/* ===== INPUT BAR ===== */
inputbar {
    background-color: transparent;

    border: 2px;
    border-color: #ff0000;
    border-radius: 10px;

    padding: 10px;

    children: [ prompt, entry ];
}

prompt {
    text-color: #ff0000;
    margin: 0px 6px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: #ff0000;
}

/* ===== LIST VIEW (FIXES EMPTY BAR BUG) ===== */
listview {
    background-color: transparent;

    padding: 6px;
    spacing: 3px;

    lines: 10;
    fixed-height: false; /* IMPORTANT FIX */
}

/* ===== ITEMS ===== */
element {
    background-color: transparent;
    text-color: #ff0000;

    padding: 8px;
    border-radius: 6px;
}

/* TEXT (ensures no white blocks) */
element-text {
    background-color: transparent;
    text-color: inherit;
}

/* Hover */
element normal active {
    background-color: rgba(255, 60, 60, 0.15);
    text-color: #ff0000;
}

/* ===== SELECTED (FINAL FIX) ===== */
element selected.normal {
    background-color: #ff0000;
    text-color: #000000;
}

/* Force text inside selected to be black */
element selected.normal element-text {
    text-color: #000000;
}

/* ===== SCROLL ===== */
scrollbar {
    background-color: transparent;
    width: 4px;
    handle-color: #ff0000;
}

/* ===== MESSAGE ===== */
message {
    background-color: transparent;
    text-color: #ff0000;
}

/* ===== ERROR ===== */
error-message {
    background-color: #ff0000;
    text-color: #000000;
    padding: 10px;
    border-radius: 8px;
}
